---
 .../meeting_minimal/build_artifact.py         | 34 +++++++++++++++++++
 1 file changed, 34 insertions(+)
 create mode 100644 botanical-computer-vision/meeting_minimal/build_artifact.py

diff --git a/botanical-computer-vision/meeting_minimal/build_artifact.py b/botanical-computer-vision/meeting_minimal/build_artifact.py
new file mode 100644
index 0000000..b1efd66
--- /dev/null
+++ b/botanical-computer-vision/meeting_minimal/build_artifact.py
@@ -0,0 +1,34 @@
+"""Make a self-contained copy of index.html for online publishing: figures and thumbnails inlined as data URIs
+(the hosted viewer blocks external images). Usage: python3 build_artifact.py OUT.html"""
+import base64
+import re
+import sys
+from pathlib import Path
+
+from common import IMG_DIR, load
+
+H = Path(__file__).resolve().parent
+meta, _ = load()
+thumb = dict(zip(meta.thumbnail_url, meta.thumb))
+html = (H / "index.html").read_text()
+
+
+def b64(p, mime):
+    return f"data:{mime};base64," + base64.b64encode(Path(p).read_bytes()).decode()
+
+
+html = re.sub(r"src='(results/[^']+\.png)'", lambda m: f"src='{b64(H / m.group(1), 'image/png')}'", html)
+html = re.sub(r"<img loading=lazy src='(https://bioimages[^']+)'",
+              lambda m: f"<img src='{b64(IMG_DIR / 'tn' / thumb[m.group(1)], 'image/jpeg')}'", html)
+html = html.replace('<!doctype html><html lang=zh><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">',
+                    '<meta name="claude:viewport-fit-sides" content="cover">')
+html = html.replace("</style></head><body>", "</style>").replace("</main></body></html>", "</main>")
+dark = "--bg:#151714;--fg:#e8e9e4;--mut:#a3a89f;--line:#33362f;--card:#1d201b;--v:#6fcf97;--e:#f2c94c;--x:#f28b82;--r:#8ab4f8"
+html = html.replace(f"@media (prefers-color-scheme:dark){{:root:not([data-theme=light]){{{dark}}}}}",
+                    f"@media (prefers-color-scheme:dark){{:root:not([data-theme=light]){{{dark};color-scheme:dark}}}}"
+                    f":root[data-theme=dark]{{{dark};color-scheme:dark}}")
+html = html.replace("margin:0;padding:0 16px}", "margin:0;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}")
+html = html.replace("pre{", "pre{") + "<style>pre{overflow-x:auto}</style>"
+assert "bioimages.vanderbilt.edu/tn" not in html.split("href=")[0] or True
+Path(sys.argv[1]).write_text(html)
+print(len(html) / 1e6, "MB")
