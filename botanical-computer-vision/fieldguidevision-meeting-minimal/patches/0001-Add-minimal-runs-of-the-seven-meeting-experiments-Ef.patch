index 0000000..e68caa8
--- /dev/null
+++ b/botanical-computer-vision/meeting_minimal/exp2_enrichment.py
@@ -0,0 +1,83 @@
+"""Exp 2b: composition + enrichment of EXISTING K=20 clusters (BioCLIP, DINOv3, EfficientNet), all 1,641 images.
+
+Descriptive only. Images are nested in individuals (465) and species (63), so Fisher/chi-square
+independence fails; no p-values are produced. For each cluster x label:
+  count, base rate, fold enrichment (FE), 95% CI from an individual-level bootstrap (500 resamples),
+  species-adjusted FE = observed / expected-given-the-cluster's-species-mix (expected = sum over
+  images in cluster of P(label | species) from all 1,641), n individuals, n species, top species share.
+Clusters with < 5 individuals are flagged.
+"""
+import numpy as np
+import pandas as pd
+
+from common import OUT, SEED, load, save_json, input_record
+
+meta, _ = load()
+rng = np.random.default_rng(SEED)
+inds = meta.individual_id.values
+uniq_ind = np.unique(inds)
+ind_rows = {u: np.where(inds == u)[0] for u in uniq_ind}
+B = 500
+boot_idx = [np.concatenate([ind_rows[u] for u in rng.choice(uniq_ind, len(uniq_ind))]) for _ in range(B)]
+
+out = []
+for rep in ["bioclip_k20", "dinov3_k20", "eff_k20"]:
+    cl = meta[rep].values
+    for lab in ["organ", "shot_scale"]:
+        y = meta[lab].values
+        p_sp = pd.crosstab(meta.species, meta[lab], normalize="index")
+        for c in np.unique(cl):
+            inc = cl == c
+            sub = meta[inc]
+            for v in np.unique(y):
+                base = (y == v).mean()
+                obs = (y[inc] == v).mean()
+                fe = obs / base
+                bs = []
+                for ix in boot_idx:
+                    ci, yi = cl[ix] == c, y[ix]
+                    if ci.sum() and (yi == v).any():
+                        bs.append((yi[ci] == v).mean() / (yi == v).mean())
+                expv = p_sp.loc[sub.species, v].mean() if v in p_sp else np.nan
+                out.append(dict(representation=rep.replace("_k20", ""), label_type=lab, cluster=int(c), label=v,
+                                n_images=int(inc.sum()), count=int((y[inc] == v).sum()), cluster_share=obs, base_rate=base,
+                                fold_enrichment=fe, fe_ci_lo=np.percentile(bs, 2.5), fe_ci_hi=np.percentile(bs, 97.5),
+                                species_adjusted_fe=obs / expv if expv > 0 else np.nan,
+                                n_individuals=sub.individual_id.nunique(), n_species=sub.species.nunique(),
+                                top_species=sub.species.value_counts().index[0],
+                                top_species_share=sub.species.value_counts(normalize=True).iloc[0],
+                                flag_lt5_individuals=sub.individual_id.nunique() < 5))
+df = pd.DataFrame(out)
+df.to_csv(OUT / "exp2_enrichment_all.csv", index=False)
+
+# headline: for each cluster, its dominant label; CI lower bound > 1 is "robust to individual resampling"
+dom = df[df["count"] >= 5].sort_values("fold_enrichment", ascending=False).groupby(["representation", "label_type", "cluster"]).head(1)
+dom.to_csv(OUT / "exp2_enrichment_top_per_cluster.csv", index=False)
+summ = {}
+for (rep, lt), g in dom.groupby(["representation", "label_type"]):
+    summ[f"{rep}/{lt}"] = dict(
+        clusters=len(g),
+        clusters_dominant_share_ge_0_6=int((g.cluster_share >= .6).sum()),
+        clusters_fe_ci_lo_gt_1_5=int((g.fe_ci_lo > 1.5).sum()),
+        clusters_species_adjusted_fe_gt_1_5=int((g.species_adjusted_fe > 1.5).sum()),
+        median_top_species_share=float(g.top_species_share.median()),
+        clusters_lt5_individuals=int(g.flag_lt5_individuals.sum()))
+save_json("exp2_enrichment_summary.json", dict(inputs=input_record(), bootstrap=B, unit="individual plant",
+                                               no_p_values_reason="images nested in individuals/species; independence assumption fails",
+                                               summary=summ))
+print(pd.DataFrame(summ).T)
+
+import matplotlib; matplotlib.use("Agg"); import matplotlib.pyplot as plt
+fig, axes = plt.subplots(1, 3, figsize=(13, 4.2), sharey=True)
+organs = ["leaf", "whole tree", "inflorescence", "fruit", "twig", "bark", "cone", "other"]
+cols = plt.cm.tab10(np.arange(8))
+for ax, rep in zip(axes, ["bioclip_k20", "dinov3_k20", "eff_k20"]):
+    ct = pd.crosstab(meta[rep], meta.organ, normalize="index").reindex(columns=organs, fill_value=0)
+    ct = ct.loc[ct.max(1).sort_values(ascending=False).index]
+    left = np.zeros(len(ct))
+    for o, col in zip(organs, cols):
+        ax.barh(range(len(ct)), ct[o], left=left, color=col, label=o); left += ct[o].values
+    ax.set_yticks(range(len(ct))); ax.set_yticklabels([f"c{c}" for c in ct.index], fontsize=7)
+    ax.set_title(rep.replace("_k20", " K=20") + " — organ composition", fontsize=9); ax.invert_yaxis()
+axes[-1].legend(fontsize=7, bbox_to_anchor=(1, 1))
+plt.tight_layout(); plt.savefig(OUT / "exp2_organ_composition.png", dpi=110)
diff --git a/botanical-computer-vision/meeting_minimal/exp3_activation.py b/botanical-computer-vision/meeting_minimal/exp3_activation.py
new file mode 100644
index 0000000..061da16
--- /dev/null
+++ b/botanical-computer-vision/meeting_minimal/exp3_activation.py
@@ -0,0 +1,156 @@
+"""Exp 3: Grad-CAM + occlusion control on real images, EfficientNet-B0 (the only model whose raw
+vectors AND weights are available here). Target score = cosine(image embedding, K=20 cluster centroid),
+fp32 on CPU. BioCLIP / DINOv3: not run (no raw vectors in Git; recorded as blocked).
+
+Steps
+ 0. Re-embed 40 random images and compare with the stored vectors (checks preprocessing/model).
+ 1. Sample: for every K=20 cluster, 2 core + 2 boundary images (by distance rank), seed 42 -> 80 images.
+ 2. Grad-CAM on model.features[-1] w.r.t. target score.
+ 3. Occlusion control: grey out the top-25% Grad-CAM cells (7x7 grid) vs 10 random sets of equal size;
+    record score drop. Faithful if top-CAM drop > mean random drop.
+ 4. Sanity (Adebayo): re-initialise the last feature block, recompute CAM, Spearman vs original.
+"""
+import numpy as np
+import pandas as pd
+import torch
+import torch.nn.functional as F
+from PIL import Image
+from scipy.stats import spearmanr
+from torchvision.models import efficientnet_b0, EfficientNet_B0_Weights
+
+from common import IMG_DIR, OUT, SEED, load, save_json, input_record
+
+torch.manual_seed(SEED)
+torch.set_num_threads(4)
+meta, X = load()
+weights = EfficientNet_B0_Weights.IMAGENET1K_V1
+model = efficientnet_b0(weights=weights).eval()
+for p in model.parameters():
+    p.requires_grad_(False)
+tf = weights.transforms()
+rng = np.random.default_rng(SEED)
+
+
+def img_tensor(i):
+    with Image.open(IMG_DIR / "gq" / meta.thumb[i]) as im:
+        return tf(im.convert("RGB")).unsqueeze(0)
+
+
+def embed(x, m=model):
+    return F.normalize(torch.flatten(m.avgpool(m.features(x)), 1), dim=-1)
+
+
+# 0. reproduction check
+chk = rng.choice(len(meta), 40, replace=False)
+with torch.no_grad():
+    E = torch.cat([embed(img_tensor(i)) for i in chk]).numpy()
+repro = (E * X[chk]).sum(1)
+print("re-embed cosine vs stored: median %.4f min %.4f" % (np.median(repro), repro.min()))
+
+cent = np.stack([X[meta.eff_k20 == c].mean(0) for c in range(20)])
+cent = cent / np.linalg.norm(cent, axis=1, keepdims=True)
+cent_t = torch.tensor(cent)
+
+
+def cam_and_score(x, c, m=model):
+    feats = {}
+    h = m.features[-1].register_forward_hook(lambda mod, i, o: feats.__setitem__("a", o))
+    x = x.clone().requires_grad_(True)
+    e = embed(x, m)
+    s = (e * cent_t[c]).sum()
+    a = feats["a"]
+    g, = torch.autograd.grad(s, a)
+    h.remove()
+    w = g.mean(dim=(2, 3), keepdim=True)
+    cam = F.relu((w * a).sum(1))[0].detach().numpy()  # 7x7
+    return cam, float(s)
+
+
+MEAN = torch.zeros(1, 3, 1, 1)  # normalised-space zero == ImageNet mean grey
+
+
+def occlude(x, cells):
+    y = x.clone()
+    for r, c in cells:
+        y[:, :, r * 32:(r + 1) * 32, c * 32:(c + 1) * 32] = MEAN
+    return y
+
+
+def score(x, c):
+    with torch.no_grad():
+        return float((embed(x) * cent_t[c]).sum())
+
+
+# 1. sample
+dist = 1 - (X * cent[meta.eff_k20.values]).sum(1)
+rows = []
+for c in range(20):
+    idx = np.where(meta.eff_k20 == c)[0]
+    order = idx[np.argsort(dist[idx])]
+    q = max(1, len(order) // 4)
+    core = rng.choice(order[:q], min(2, q), replace=False)
+    bnd = rng.choice(order[-q:], min(2, q), replace=False)
+    rows += [(i, c, "core") for i in core] + [(i, c, "boundary") for i in bnd]
+
+K = 12  # top 25% of 49 cells
+res = []
+cams = {}
+for i, c, kind in rows:
+    x = img_tensor(i)
+    cam, s0 = cam_and_score(x, c)
+    flat = np.argsort(cam.ravel())[::-1]
+    top = [divmod(int(j), 7) for j in flat[:K]]
+    d_top = s0 - score(occlude(x, top), c)
+    d_rand = [s0 - score(occlude(x, [divmod(int(j), 7) for j in rng.choice(49, K, replace=False)]), c) for _ in range(10)]
+    own = int(np.argmax(cent @ X[i]))
+    res.append(dict(image_id=meta.image_id[i], cluster=c, kind=kind, organ=meta.organ[i], scale=meta.shot_scale[i],
+                    species=meta.species[i], score=s0, nearest_centroid_is_cluster=own == c,
+                    drop_top_cam=d_top, drop_random_mean=float(np.mean(d_rand)), drop_random_sd=float(np.std(d_rand)),
+                    top_beats_random=d_top > np.mean(d_rand),
+                    cam_center_mass=float(cam[2:5, 2:5].sum() / (cam.sum() + 1e-12))))
+    cams[meta.image_id[i]] = cam
+df = pd.DataFrame(res)
+df.to_csv(OUT / "exp3_activation_cases.csv", index=False)
+
+# 4. sanity: randomise last block
+import copy
+rmodel = copy.deepcopy(model)
+for mod in rmodel.features[-1].modules():
+    if hasattr(mod, "reset_parameters"):
+        mod.reset_parameters()
+san = []
+for i, c, kind in rows[:24]:
+    x = img_tensor(i)
+    cr, _ = cam_and_score(x, c, rmodel)
+    san.append(spearmanr(cams[meta.image_id[i]].ravel(), cr.ravel())[0])
+san = np.nan_to_num(np.array(san))
+
+summary = dict(inputs=input_record(), model=str(weights), n_cases=len(df),
+               reembed_cosine_median=float(np.median(repro)), reembed_cosine_min=float(repro.min()),
+               frac_top_cam_beats_random=float(df.top_beats_random.mean()),
+               frac_by_kind=df.groupby("kind").top_beats_random.mean().to_dict(),
+               median_drop_top=float(df.drop_top_cam.median()), median_drop_random=float(df.drop_random_mean.median()),
+               sanity_spearman_vs_randomised_last_block_median=float(np.median(san)),
+               mean_cam_center_mass_3x3=float(df.cam_center_mass.mean()), center_mass_uniform_expectation=9 / 49,
+               note="Sampled 2 core + 2 boundary per cluster, seed 42, not hand-picked. No organ masks: "
+                    "says whether the map is faithful to the score, not whether it is on the organ.")
+save_json("exp3_activation_summary.json", summary)
+np.savez_compressed(OUT / "exp3_cams.npz", ids=np.array(list(cams)), cams=np.stack(list(cams.values())))
+print(summary)
+
+# figure: 8 showcase cases (first core + first boundary of 4 clusters with most images)
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+big = meta.eff_k20.value_counts().index[:4]
+show = pd.concat([df[(df.cluster == c)].groupby("kind").head(1) for c in big])
+fig, ax = plt.subplots(2, len(show), figsize=(2.3 * len(show), 5))
+for j, r in enumerate(show.itertuples()):
+    i = int(np.where(meta.image_id == r.image_id)[0][0])
+    im = Image.open(IMG_DIR / "gq" / meta.thumb[i]).convert("RGB").resize((224, 224))
+    ax[0, j].imshow(im); ax[0, j].set_title(f"c{r.cluster} {r.kind}\n{r.organ}, {r.scale}", fontsize=8)
+    ax[1, j].imshow(im); ax[1, j].imshow(np.kron(cams[r.image_id], np.ones((32, 32))), alpha=.5, cmap="jet")
+    ax[1, j].set_title(f"drop top {r.drop_top_cam:.3f}\nrandom {r.drop_random_mean:.3f}", fontsize=8)
+for a in ax.ravel():
+    a.axis("off")
+plt.tight_layout(); plt.savefig(OUT / "exp3_gradcam_cases.png", dpi=110)
diff --git a/botanical-computer-vision/meeting_minimal/exp4_soft.py b/botanical-computer-vision/meeting_minimal/exp4_soft.py
new file mode 100644
index 0000000..90f30e1
--- /dev/null
+++ b/botanical-computer-vision/meeting_minimal/exp4_soft.py
@@ -0,0 +1,67 @@
+"""Exp 4: reuse existing K comparison (K=10/20/50 x 10 seeds) + minimal soft-membership experiment.
+
+Soft model: diagonal GMM, K=20, on PCA-32 of EfficientNet vectors (fit on all 1,641; descriptive).
+Per image: max membership, membership entropy. Checks:
+  - seed stability of hard GMM labels (5 seeds, pairwise ARI) and of the entropy ranking (Spearman)
+  - BIC for K in {5,10,20,30,50}
+  - AUROC of entropy for (a) EfficientNet probe error on the 211 test images, (b) shot_scale == mid-range
+    (the "in between" scale). Multi-organ AUROC cannot be computed: no multi-organ labels in Git
+    (Gemma multi-labels / Human Gold not exported) -> recorded as not done.
+Soft probability is NOT multi-organ evidence; it is model uncertainty about which Gaussian.
+"""
+import numpy as np
+import pandas as pd
+from scipy.stats import spearmanr
+from sklearn.decomposition import PCA
+from sklearn.metrics import adjusted_rand_score, roc_auc_score
+from sklearn.mixture import GaussianMixture
+
+from common import BCV, OUT, SEED, load, save_json, input_record
+
+meta, X = load()
+Z = PCA(32, random_state=SEED).fit_transform(X)
+
+ms = pd.read_csv(BCV / "representation_analysis/data/multiseed_cluster_summary.csv")
+ms_keep = ms[["representation", "k", "seeds", "species_nmi_mean", "organ_nmi_mean", "stability_pairwise_ari_mean"]]
+ms_keep.to_csv(OUT / "exp4_existing_k_comparison.csv", index=False)
+
+bic = {}
+for k in [5, 10, 20, 30, 50]:
+    bic[k] = float(GaussianMixture(k, covariance_type="diag", random_state=SEED, n_init=2).fit(Z).bic(Z))
+gms = [GaussianMixture(20, covariance_type="diag", random_state=s, n_init=1).fit(Z) for s in range(SEED, SEED + 5)]
+P = [g.predict_proba(Z) for g in gms]
+H = [-(p * np.log(p + 1e-12)).sum(1) for p in P]
+labels = [p.argmax(1) for p in P]
+ari = [adjusted_rand_score(labels[i], labels[j]) for i in range(5) for j in range(i + 1, 5)]
+hrho = [spearmanr(H[i], H[j])[0] for i in range(5) for j in range(i + 1, 5)]
+p, h = P[0], H[0]
+meta["gmm_max"] = p.max(1); meta["gmm_entropy"] = h
+meta["gmm_top1"] = p.argsort(1)[:, -1]; meta["gmm_top2"] = p.argsort(1)[:, -2]
+meta["gmm_p2"] = np.sort(p, 1)[:, -2]
+meta["ari_gmm_vs_kmeans20"] = adjusted_rand_score(labels[0], meta.eff_k20)
+
+pred = pd.read_csv(BCV / "data/embeddings/efficientnet_b0_strict/all_predictions.csv").set_index("image_id")
+tm = meta[meta.split == "test"].copy()
+tm["wrong"] = ~pred.loc[tm.image_id, "correct"].astype(bool).values
+auc_err = roc_auc_score(tm.wrong, tm.gmm_entropy)
+sm = meta[meta.shot_scale != "uncertain"]
+auc_mid = roc_auc_score(sm.shot_scale == "mid-range", sm.gmm_entropy)
+frac_ambig = float((meta.gmm_max < 0.6).mean())
+
+# organ composition of each GMM component (for describing the ambiguous cases)
+comp_organ = meta.groupby("gmm_top1").organ.agg(lambda s: f"{s.value_counts().index[0]} {s.value_counts(normalize=True).iloc[0]:.0%}")
+amb = meta.sort_values("gmm_entropy", ascending=False).head(12).copy()
+amb["top1_component_main_organ"] = amb.gmm_top1.map(comp_organ)
+amb["top2_component_main_organ"] = amb.gmm_top2.map(comp_organ)
+cols = ["image_id", "thumb", "species", "organ", "shot_scale", "gmm_top1", "gmm_max", "gmm_top2", "gmm_p2", "gmm_entropy",
+        "top1_component_main_organ", "top2_component_main_organ"]
+amb[cols].to_csv(OUT / "exp4_ambiguous_cases.csv", index=False)
+meta[["image_id", "gmm_top1", "gmm_max", "gmm_top2", "gmm_p2", "gmm_entropy"]].to_csv(OUT / "exp4_soft_memberships.csv", index=False)
+summ = dict(inputs=input_record(), space="PCA-32 (all 1,641, descriptive)", model="GaussianMixture diag K=20",
+            bic=bic, seed_label_ari_mean=float(np.mean(ari)), seed_label_ari_min=float(np.min(ari)),
+            seed_entropy_spearman_mean=float(np.mean(hrho)), ari_gmm_vs_existing_kmeans20=float(meta.ari_gmm_vs_kmeans20[0]),
+            frac_images_max_membership_lt_0_6=frac_ambig, auroc_entropy_vs_probe_error_test211=auc_err,
+            n_test_wrong=int(tm.wrong.sum()), auroc_entropy_vs_midrange_scale=auc_mid,
+            multi_organ_auroc="NOT COMPUTED - no multi-organ labels in Git (Gemma multi-label / Human Gold not exported)")
+save_json("exp4_soft_summary.json", summ)
+print(summ)
diff --git a/botanical-computer-vision/meeting_minimal/exp5_axes.py b/botanical-computer-vision/meeting_minimal/exp5_axes.py
new file mode 100644
index 0000000..577d40f
--- /dev/null
+++ b/botanical-computer-vision/meeting_minimal/exp5_axes.py
@@ -0,0 +1,63 @@
+"""Exp 5: (a) AE result recovered from the hosted site (not recomputed) + one sanity check: a LINEAR AE
+(32-d, train 1,181 -> test 211) should match PCA-32 reconstruction. (b) Axis reading: PCs 1-5 of EfficientNet
+(fit on train), rank correlation of PC score with shot scale (distant=0, mid=1, close=2), organ one-vs-rest,
+and thumbnail brightness; 6 real images at each end.
+"""
+import numpy as np
+import pandas as pd
+import torch
+from PIL import Image
+from scipy.stats import spearmanr
+from sklearn.decomposition import PCA
+
+from common import IMG_DIR, OUT, SEED, load, save_json, input_record
+
+meta, X = load()
+tr, te = (meta.split == "train").values, (meta.split == "test").values
+
+# (a) recovered table (scale/meeting/ on the hosted site, saved in recovered_site/scale_meeting_index.html)
+recovered = [("bioclip25", "PCA", .000284, .667299), ("bioclip25", "Autoencoder", .000280, .616746),
+             ("dinov3", "PCA", .000498, .766509), ("dinov3", "Autoencoder", .000491, .745656),
+             ("efficientnet_b0", "PCA", .000296, .729542), ("efficientnet_b0", "Autoencoder", .000301, .721327)]
+rec = pd.DataFrame(recovered, columns=["model", "method", "test_mse", "knn15_retention"])
+rec.to_csv(OUT / "exp5_recovered_ae_table.csv", index=False)
+
+# linear AE sanity
+mu = X[tr].mean(0)
+pca = PCA(32, random_state=SEED).fit(X[tr])
+pca_mse = float(((X[te] - pca.inverse_transform(pca.transform(X[te]))) ** 2).mean())
+torch.manual_seed(SEED)
+A = torch.tensor(X[tr] - mu); T = torch.tensor(X[te] - mu)
+enc = torch.nn.Linear(1280, 32, bias=False); dec = torch.nn.Linear(32, 1280, bias=False)
+opt = torch.optim.Adam(list(enc.parameters()) + list(dec.parameters()), lr=1e-3)
+for ep in range(3000):
+    opt.zero_grad(); loss = ((dec(enc(A)) - A) ** 2).mean(); loss.backward(); opt.step()
+with torch.no_grad():
+    lin_mse = float(((dec(enc(T)) - T) ** 2).mean())
+
+# (b) axis reading
+pc = PCA(10, random_state=SEED).fit(X[tr])
+S = pc.transform(X)
+bright = np.array([np.asarray(Image.open(IMG_DIR / "tn" / t).convert("L"), dtype=float).mean() for t in meta.thumb])
+scale_ord = meta.shot_scale.map({"distant": 0, "mid-range": 1, "close-up": 2})
+ok = scale_ord.notna().values
+rows, ends = [], {}
+for k in range(5):
+    r = dict(pc=k + 1, var=float(pc.explained_variance_ratio_[k]),
+             rho_scale_close=spearmanr(S[ok, k], scale_ord[ok])[0], rho_brightness=spearmanr(S[:, k], bright)[0])
+    for o in ["leaf", "whole tree", "inflorescence", "fruit", "twig", "bark"]:
+        r[f"rho_{o}"] = spearmanr(S[:, k], meta.organ == o)[0]
+    o_r = {o: r[f"rho_{o}"] for o in ["leaf", "whole tree", "inflorescence", "fruit", "twig", "bark"]}
+    lo, hi = min(o_r, key=o_r.get), max(o_r, key=o_r.get)
+    r["reading"] = f"low end ~ {lo}, high end ~ {hi}"
+    rows.append(r)
+    order = np.argsort(S[:, k])
+    ends[k + 1] = dict(low=meta.iloc[order[:6]][["image_id", "thumb", "species", "organ", "shot_scale"]].to_dict("records"),
+                       high=meta.iloc[order[-6:][::-1]][["image_id", "thumb", "species", "organ", "shot_scale"]].to_dict("records"))
+ax = pd.DataFrame(rows)
+ax.to_csv(OUT / "exp5_axis_table.csv", index=False)
+save_json("exp5_axes_summary.json", dict(inputs=input_record(), recovered_ae_source="hosted site scale/meeting/ (Experiment 6 table)",
+                                         linear_ae_sanity=dict(pca32_test_mse=pca_mse, linear_ae32_test_mse=lin_mse,
+                                                               ratio=lin_mse / pca_mse, epochs=3000),
+                                         axes=rows, ends=ends))
+print(ax.round(3).to_string()); print("PCA", pca_mse, "linAE", lin_mse)
diff --git a/botanical-computer-vision/meeting_minimal/exp6_pca_fidelity.py b/botanical-computer-vision/meeting_minimal/exp6_pca_fidelity.py
new file mode 100644
index 0000000..e5882e1
--- /dev/null
+++ b/botanical-computer-vision/meeting_minimal/exp6_pca_fidelity.py
@@ -0,0 +1,69 @@
+"""Exp 6 (+ PCA part of exp 2): how much does PCA-d keep? EfficientNet-B0 raw vectors.
+PCA fit on train (1,181); everything reported on validation (249) unless noted.
+Metrics per d: explained variance (train), val reconstruction R^2, 15-NN overlap vs full space (val pool),
+trustworthiness (val), linear-probe species/organ macro-F1 on val, K-means(K=20) ARI vs full-space K-means (val).
+"""
+import numpy as np
+import pandas as pd
+from sklearn.cluster import KMeans
+from sklearn.decomposition import PCA
+from sklearn.linear_model import LogisticRegression
+from sklearn.manifold import trustworthiness
+from sklearn.metrics import adjusted_rand_score, f1_score
+import warnings; warnings.filterwarnings("ignore")
+
+from common import OUT, SEED, load, knn_overlap, save_json, input_record
+
+meta, X = load()
+tr, va = (meta.split == "train").values, (meta.split == "validation").values
+Xtr, Xva = X[tr], X[va]
+pca_full = PCA(n_components=256, random_state=SEED).fit(Xtr)
+
+
+def probe(Ztr, Zva, y):
+    # C=100 = validation-selected C of the existing EfficientNet benchmark
+    clf = LogisticRegression(max_iter=3000, C=100.0).fit(Ztr, y[tr])
+    return f1_score(y[va], clf.predict(Zva), average="macro")
+
+
+km_full = KMeans(20, n_init=10, random_state=SEED).fit(Xtr).predict(Xva)
+rows = []
+for d in [2, 8, 16, 32, 64, 128, 256, "full"]:
+    if d == "full":
+        Ztr, Zva = Xtr, Xva; ev = 1.0; r2 = 1.0; ov = 1.0; tw = 1.0
+    else:
+        Ztr, Zva = pca_full.transform(Xtr)[:, :d], pca_full.transform(Xva)[:, :d]
+        ev = float(pca_full.explained_variance_ratio_[:d].sum())
+        rec = Zva @ pca_full.components_[:d] + pca_full.mean_
+        r2 = 1 - ((Xva - rec) ** 2).sum() / ((Xva - Xva.mean(0)) ** 2).sum()
+        ov = knn_overlap(Xva, Zva, 15)
+        tw = trustworthiness(Xva, Zva, n_neighbors=15)
+    km = KMeans(20, n_init=10, random_state=SEED).fit(Ztr).predict(Zva)
+    rows.append(dict(d=d, train_explained_var=ev, val_recon_r2=float(r2), val_knn15_overlap=ov, val_trustworthiness=float(tw),
+                     probe_species_macroF1=probe(Ztr, Zva, meta.species.values),
+                     probe_organ_macroF1=probe(Ztr, Zva, meta.organ.values),
+                     kmeans20_ARI_vs_full=adjusted_rand_score(km_full, km)))
+    print(rows[-1])
+df = pd.DataFrame(rows)
+df.to_csv(OUT / "exp6_pca_fidelity.csv", index=False)
+
+full = df[df.d == "full"].iloc[0]
+ok = df[(df.d != "full") & (df.val_knn15_overlap >= 0.85) & (df.probe_species_macroF1 >= full.probe_species_macroF1 - 0.01)]
+dstar = int(ok.d.iloc[0]) if len(ok) else None
+# descriptive on all 1,641 for 2-D (comparable to the existing site number for BioCLIP)
+Z2 = PCA(2, random_state=SEED).fit_transform(X)
+all2 = dict(knn15_overlap_all1641=knn_overlap(X, Z2, 15), trustworthiness_all1641=float(trustworthiness(X, Z2, n_neighbors=15)))
+save_json("exp6_summary.json", dict(inputs=input_record(), d_star_rule="smallest d with val 15-NN>=0.85 and species probe within 1pp of full",
+                                    d_star=dstar, two_d_all_images=all2, table=rows))
+
+import matplotlib; matplotlib.use("Agg"); import matplotlib.pyplot as plt
+dd = df[df.d != "full"]
+fig, ax = plt.subplots(figsize=(6.5, 3.8))
+x = dd.d.astype(int)
+for col, lab in [("train_explained_var", "explained variance"), ("val_knn15_overlap", "15-NN overlap (val)"),
+                 ("val_trustworthiness", "trustworthiness (val)"), ("probe_organ_macroF1", "organ probe F1"),
+                 ("probe_species_macroF1", "species probe F1"), ("kmeans20_ARI_vs_full", "K=20 ARI vs full")]:
+    ax.plot(x, dd[col], marker="o", label=lab)
+ax.set_xscale("log", base=2); ax.set_xlabel("PCA dimensions d (fit on train)"); ax.set_ylim(0, 1.02)
+ax.axhline(0.85, color="grey", ls=":", lw=1); ax.legend(fontsize=7, loc="lower right"); ax.set_title("EfficientNet-B0: what PCA-d keeps")
+plt.tight_layout(); plt.savefig(OUT / "exp6_pca_fidelity.png", dpi=120)
