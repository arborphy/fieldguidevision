FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install \
    flask==3.1.2 \
    gdown==5.2.0 \
    gunicorn==23.0.0 \
    matplotlib==3.10.1 \
    modal==1.2.1 \
    numpy==2.2.6 \
    open_clip_torch==3.2.0 \
    pandas==2.2.3 \
    pillow==11.3.0 \
    scikit-learn==1.7.2 \
    torch==2.7.1 \
    torchvision==0.22.1

WORKDIR /root
COPY dual_encoder_fusion /root/dual_encoder_fusion
COPY individual_disjoint.csv /root/individual_disjoint.csv

CMD exec gunicorn \
    --bind :${PORT} \
    --workers 1 \
    --threads 1 \
    --timeout 3700 \
    dual_encoder_fusion.cloud_run_service:app
